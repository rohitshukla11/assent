# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local ciphertext store (dev only)
.data/
.models/

# local secrets (test C2PA cert and key, judge passwords, render-check output): never committed
.secrets/
*.key
# face-matcher weights (downloaded by scripts/face-models.sh into .models/)
*.onnx
# local eval and demo outputs (generated images)
.data-demo/
# logs, editor and tool folders
*.log
.idea/
.vscode/
.claude/
