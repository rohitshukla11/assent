# Copy to .env.local at the repository root (git-ignored, never committed). Every value here is a safe
# placeholder or a default. Google APIs use Application Default Credentials (`gcloud auth
# application-default login` locally, the Cloud Run service account in production), so no Google key
# goes in this file. The only secret is MODEL_API_KEY (Meta), which stays in .env.local or Secret Manager.

# --- Firebase web app (Project settings → Your apps → Web app); compiled into the page, public by design ---
# Web API key of the Firebase app (identifies the project; not a secret).
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
# Auth domain, usually <project>.firebaseapp.com.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# Firebase project id.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
# Firebase web app id.
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# Public URL of the app (written into each C2PA credential as where to verify).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Cloud ---
# Project that holds Firestore, Storage, KMS and Secret Manager.
GOOGLE_CLOUD_PROJECT=your-project
# Older name for the same project id; used only if GOOGLE_CLOUD_PROJECT is unset.
# GCLOUD_PROJECT=
# Region of the KMS keys and the Cloud Run service.
GCP_REGION=us-central1
# Firestore database id (likeness-ai's database "likeness" is refused).
FIRESTORE_DATABASE=likeness-meta
# Private bucket for encrypted reference photos and renders (default <project>-likeness-meta-private).
GCS_BUCKET=your-project-likeness-meta-private
# KMS key ring that holds both keys.
KMS_KEYRING=likeness
# KMS key that wraps each creator's photo key (envelope encryption).
KMS_PHOTO_KEY=photos
# KMS asymmetric key that signs render receipts (EC_SIGN_P256_SHA256).
KMS_RECEIPT_KEY=receipts
# Version of the receipt key used for signing.
KMS_RECEIPT_KEY_VERSION=1

# --- AI provider ---
# "meta" (Meta Model API, the default), "google" (the fallback: Vertex AI Gemini) or "fixture" (development only, no model calls).
AI_PROVIDER=meta
# Meta Model API key (https://dev.meta.ai); needed with AI_PROVIDER=meta. Secret: .env.local or Secret Manager only.
MODEL_API_KEY=
# Meta Model API base URL.
META_API_BASE=https://api.meta.ai/v1
# Muse Image model id.
MUSE_IMAGE_MODEL=muse-image-1.0
# Muse Image sampling temperature (console default).
MUSE_IMAGE_TEMPERATURE=0.6
# Muse Image top_p (console default).
MUSE_IMAGE_TOP_P=0.9
# Muse Image output token cap.
MUSE_IMAGE_MAX_OUTPUT_TOKENS=2048
# "low" (the default: one pass, about half the time) or "high" (refinement passes); same price per image.
MUSE_IMAGE_REASONING_STRENGTH=low
# Muse Spark model id (brand agent, policy check, output reviewer).
MUSE_SPARK_MODEL=muse-spark-1.3
# Muse Spark output token cap.
MUSE_SPARK_MAX_OUTPUT_TOKENS=4096
# Reasoning effort for every Spark call (none … max); unset uses the per-call values below, then Meta's default ("high").
MUSE_SPARK_REASONING_EFFORT=
# Reasoning effort for the brand agent's plan and alternative shot (chosen by the eval).
MUSE_SPARK_REASONING_EFFORT_PLAN=low
# Reasoning effort for the policy check; empty sends none, so Meta's default ("high") applies.
MUSE_SPARK_REASONING_EFFORT_POLICY=
# Reasoning effort for the output review (chosen by the eval).
MUSE_SPARK_REASONING_EFFORT_REVIEW=low
# SAM model id for the consent gate's person count.
SAM_MODEL=sam-3.1
# Show brands the estimated model cost of each render (0 hides it).
SHOW_MODEL_COST=1

# --- Fallback provider (AI_PROVIDER=google: Vertex AI, likeness-ai's behaviour) ---
# Gemini image model.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Gemini model for the policy check.
GEMINI_FILTER_MODEL=gemini-3.5-flash-lite
# Gemini output size.
GEMINI_IMAGE_SIZE=1K
# Gemini aspect ratio when the request names none.
GEMINI_ASPECT_RATIO=1:1

# --- Development provider (AI_PROVIDER=fixture; refused in production) ---
# One or more JPEG/PNG paths, comma-separated, returned in turn instead of a generated image.
FIXTURE_IMAGE_PATH=eval/fixtures/maya.jpg

# --- Face checks (YuNet + AuraFace, run on the server) ---
# Creator onboarding: a live frame must match the YouTube channel avatar at or above this.
FACE_MATCH_THRESHOLD=0.5
# Same-person threshold of the local matcher's own comparisons.
LOCAL_FACE_MATCH_THRESHOLD=0.55
# Consent gate: the face in a generated image must match the creator's references at or above this (see lib/server/facecheck.ts).
CONSENT_FACE_MATCH_THRESHOLD=0.35
# Where the face-model weights are (pnpm face:models writes them to .models).
FACE_MODELS_DIR=.models
# 1 fetches missing weights on first use (checked against the same sha256 pins); unset never downloads.
FACE_MODELS_FETCH=

# --- Limits ---
# "Write it for me" calls per UTC day, site-wide.
ASSISTS_PER_DAY=300
# Image renders per UTC day, site-wide.
RENDERS_PER_DAY=40
# Image renders per brand per UTC day.
BRAND_RENDERS_PER_DAY=3
# Image renders per UTC day for the seeded judge brand (the site-wide limit still applies).
JUDGE_BRAND_RENDERS_PER_DAY=25
# Image renders per UTC day for the eval brand (the site-wide limit still applies).
EVAL_BRAND_RENDERS_PER_DAY=20
# Render requests per user per minute.
RATE_LIMIT_RENDER_PER_MIN=6
# "Write it for me" and brand-agent plan requests per user per minute.
RATE_LIMIT_PLAN_PER_MIN=12
# "Reset demo" requests per user per minute.
RATE_LIMIT_RESET_PER_MIN=3

# --- Admin view (/admin) ---
# Firebase user ids allowed into /admin, comma-separated. Nobody by default.
ADMIN_UIDS=
# Verified emails allowed into /admin, comma-separated. Nobody by default.
ADMIN_EMAILS=

# --- C2PA signing (a TEST certificate from `pnpm c2pa:testcert`; not on the C2PA trust list) ---
# Certificate chain file used locally.
C2PA_CERT_FILE=.secrets/c2pa/signer.pem
# Private key file used locally (git-ignored).
C2PA_KEY_FILE=.secrets/c2pa/signer.key
# In production the chain and key come from Secret Manager as text instead of files; leave unset locally.
# C2PA_CERT_PEM=
# C2PA_KEY_PEM=

# --- Judge seeding (scripts/seed-judges.ts; the defaults are fine) ---
# Uid of the judge brand account.
# JUDGE_BRAND_UID=meta-judge-brand
# Uid of the judge creator account (the synthetic demo creator).
# JUDGE_CREATOR_UID=meta-demo-maya-okafor
# Sign-in email of the judge brand (passwords are generated into .secrets/judge-accounts.json).
# JUDGE_BRAND_EMAIL=judge-brand@example.com
# Sign-in email of the judge creator.
# JUDGE_CREATOR_EMAIL=judge-creator@example.com
# Uid of the eval brand used by pnpm eval (no sign-in).
# EVAL_BRAND_UID=meta-eval-brand
# The synthetic demo creator copied for the judge creator.
# DEMO_SOURCE_CREATOR=demo-maya-okafor

# --- Development and tests only ---
# 1 hides Next's dev overlay on localhost (for screen recordings).
# NEXT_PUBLIC_HIDE_DEV_OVERLAY=1
# A path: lib/server/label.test.ts also writes a labelled sample image there.
# LABEL_SAMPLE=
